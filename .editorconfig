root = true

# This file is the lintable half of .claude/rules/. Each enforced rule is listed
# in .claude/rules/linting.md next to the rule it comes from; change both together.
#
# Diagnostics set to "warning" below are reported on every build. eng/lint.ps1
# fails a change only for warnings on lines that change adds or modifies.
#
# Encoding, line endings and whitespace trimming are deliberately not set here,
# so saving a file does not rewrite lines the change did not touch.

[*.{json,yml,yaml}]
indent_style = space
indent_size = 2

[*.cs]
indent_style = space
indent_size = 4

# ---- Options (what the analyzers below check for) ----

csharp_style_namespace_declarations = file_scoped
csharp_using_directive_placement = outside_namespace
dotnet_sort_system_directives_first = true
csharp_new_line_before_open_brace = all
csharp_prefer_braces = true

# var when the type is apparent from the right-hand side, explicit type otherwise
csharp_style_var_for_built_in_types = true
csharp_style_var_when_type_is_apparent = true
csharp_style_var_elsewhere = false

# string, not String
dotnet_style_predefined_type_for_locals_parameters_members = true
dotnet_style_predefined_type_for_member_access = true

dotnet_style_prefer_is_null_check_over_reference_equality_method = true
dotnet_style_prefer_collection_expression = when_types_exactly_match
# Public inheritable types keep explicit constructors
csharp_style_prefer_primary_constructors = false

# x is null / x is not null, not x == null / x != null
roslynator_null_check_style = pattern_matching

# Roslynator is referenced for RCS1248 only; everything else it ships is off
dotnet_analyzer_diagnostic.category-roslynator.severity = none

# ---- csharp-style.md: files and formatting ----

# File-scoped namespaces
dotnet_diagnostic.IDE0161.severity = warning
# using directives outside the namespace
dotnet_diagnostic.IDE0065.severity = warning
# Braces on every block
dotnet_diagnostic.IDE0011.severity = warning

# ---- csharp-style.md: naming ----

dotnet_diagnostic.IDE1006.severity = warning

dotnet_naming_rule.interfaces_begin_with_i.symbols = interfaces
dotnet_naming_rule.interfaces_begin_with_i.style = begins_with_i
dotnet_naming_rule.interfaces_begin_with_i.severity = warning
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_style.begins_with_i.required_prefix = I
dotnet_naming_style.begins_with_i.capitalization = pascal_case

dotnet_naming_rule.type_parameters_begin_with_t.symbols = type_parameters
dotnet_naming_rule.type_parameters_begin_with_t.style = begins_with_t
dotnet_naming_rule.type_parameters_begin_with_t.severity = warning
dotnet_naming_symbols.type_parameters.applicable_kinds = type_parameter
dotnet_naming_style.begins_with_t.required_prefix = T
dotnet_naming_style.begins_with_t.capitalization = pascal_case

dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_style.underscore_camel.capitalization = camel_case

dotnet_naming_rule.async_methods_end_in_async.symbols = async_methods
dotnet_naming_rule.async_methods_end_in_async.style = ends_with_async
dotnet_naming_rule.async_methods_end_in_async.severity = warning
dotnet_naming_symbols.async_methods.applicable_kinds = method
dotnet_naming_symbols.async_methods.required_modifiers = async
dotnet_naming_style.ends_with_async.required_suffix = Async
dotnet_naming_style.ends_with_async.capitalization = pascal_case

# ---- csharp-style.md: members ----

# Protected state is a property, not a visible field
dotnet_diagnostic.CA1051.severity = warning
# Seal internal types
dotnet_diagnostic.CA1852.severity = warning

# ---- csharp-style.md: async ----

# CancellationToken is the last parameter
dotnet_diagnostic.CA1068.severity = warning
# Pass the CancellationToken on to methods that take one
dotnet_diagnostic.CA2016.severity = warning
# ConfigureAwait(false) is not used
dotnet_diagnostic.CA2007.severity = none
# Blocking on tasks (.Result, .Wait(), GetResult()) is in BannedSymbols.txt
dotnet_diagnostic.RS0030.severity = warning

# ---- csharp-style.md: language usage ----

# string keyword instead of String
dotnet_diagnostic.IDE0049.severity = warning
# var when apparent, explicit type otherwise
dotnet_diagnostic.IDE0007.severity = warning
dotnet_diagnostic.IDE0008.severity = warning
# is null / is not null
dotnet_diagnostic.IDE0041.severity = warning
dotnet_diagnostic.RCS1248.severity = warning
# Throw helpers: ThrowIfNull, ThrowIfNullOrWhiteSpace, ThrowIfNegative, ThrowIf
dotnet_diagnostic.CA1510.severity = warning
dotnet_diagnostic.CA1511.severity = warning
dotnet_diagnostic.CA1512.severity = warning
dotnet_diagnostic.CA1513.severity = warning
# Collection expressions
dotnet_diagnostic.IDE0028.severity = warning
dotnet_diagnostic.IDE0300.severity = warning
dotnet_diagnostic.IDE0301.severity = warning
dotnet_diagnostic.IDE0302.severity = warning
dotnet_diagnostic.IDE0303.severity = warning
dotnet_diagnostic.IDE0304.severity = warning
dotnet_diagnostic.IDE0305.severity = warning
# DateTime.Now, DateTime.UtcNow and friends are in BannedSymbols.txt (RS0030 above)

# ---- csharp-style.md: exceptions ----

# Don't throw Exception, NullReferenceException and other reserved types
dotnet_diagnostic.CA2201.severity = warning
# Argument exceptions get the parameter name in the right position
dotnet_diagnostic.CA2208.severity = warning

# ---- xml-docs.md ----

# Missing or malformed XML documentation
dotnet_diagnostic.CS1591.severity = warning
dotnet_diagnostic.CS1570.severity = warning
dotnet_diagnostic.CS1572.severity = warning
dotnet_diagnostic.CS1573.severity = warning
dotnet_diagnostic.CS1574.severity = warning
dotnet_diagnostic.CS1711.severity = warning
dotnet_diagnostic.CS1712.severity = warning

# ---- project-layout.md ----

# Namespaces are intentionally flatter than the folder tree; eng/lint.ps1 checks the real rule
dotnet_diagnostic.IDE0130.severity = none
